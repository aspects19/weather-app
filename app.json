{
  "expo": {
    "name": "Weather app",
    "slug": "weather-app",
    "scheme": "weather-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app-logo.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/app-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#090a15"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aspect19.weatherapp"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/app-logo.png",
        "backgroundColor": "#090a15"
      },
      "package": "com.aspect19.weatherapp"
    },
    "plugins": [
      "expo-router"
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "1ae9b33b-9a06-421a-809f-47576fe89c76"
      }
    }
  }
}
